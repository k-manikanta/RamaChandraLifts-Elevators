{
  "name": "ramachandra-lifts-website",
  "version": "1.0.0",
  "description": "Professional website for Ramachandra Lifts & Elevators",
  "main": "index.html",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./css/tailwind.css",
    "dev": "tailwindcss -i ./src/input.css -o ./css/tailwind.css --watch",
    "build:minify": "tailwindcss -i ./src/input.css -o ./css/tailwind.css --minify",
    "start": "http-server -p 8080 -o"
  },
  "keywords": [
    "elevator",
    "maintenance",
    "service",
    "lifts"
  ],
  "author": "Ramachandra Lifts & Elevators",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "http-server": "^14.1.1",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.17"
  }
}
